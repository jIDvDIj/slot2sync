{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Slot2Sync",
  "version": "0.1.0",
  "identifier": "com.slot2sync.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Slot2Sync",
        "width": 900,
        "height": 650,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBMzEyMkVCMEM0RTIwOEYKUldTUElFNE02eUl4S3JKbTVFRDYrYkQvNVREOHhUK0crNVhWRTd1aFpOK2ZXbzJiVXpqM0R3eEMK",
      "endpoints": ["https://github.com/jIDvDIj/slot2sync/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    },
    "deep-link": {
      "mobile": [{ "scheme": ["com.slot2sync.app"], "path_prefix": ["/oauth2redirect"] }]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
