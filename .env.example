# Copie para `.env` (na raiz do repositório) e preencha com as credenciais
# OAuth2 do tipo "Aplicativo da Web" (Web application) criadas no Google Cloud
# Console — um único client atende tanto o fluxo desktop (redirect loopback
# em 127.0.0.1) quanto o mobile (redirect via Worker). Veja CONTRIBUTING.md.
# O arquivo é lido em build-time pelo src-tauri/build.rs; variáveis definidas
# no shell têm precedência sobre este arquivo. NUNCA commite o `.env`.

SLOT2SYNC_GOOGLE_CLIENT_ID=
SLOT2SYNC_GOOGLE_CLIENT_SECRET=   # só no fluxo de dev local sem Worker

# Produção: use o proxy Cloudflare Worker (client_secret nunca entra no binário).
# SLOT2SYNC_TOKEN_PROXY_URL=https://slot2sync-auth.<usuario>.workers.dev
# SLOT2SYNC_PROXY_SECRET=        # mesmo valor configurado em: wrangler secret put PROXY_SECRET

# Dropbox — App Console (dropbox.com/developers/apps), tipo de app "Scoped
# access" / "App folder". PKCE puro (client público): sem client_secret nem
# proxy — o app registrado não precisa ser "confidential".
SLOT2SYNC_DROPBOX_CLIENT_ID=
# SLOT2SYNC_DROPBOX_TOKEN_PROXY_URL=   # só necessário para o fluxo mobile

# OneDrive — Azure App registrations (portal.azure.com), tipo de plataforma
# "Mobile and desktop applications", sem client secret ("public client flows"
# habilitado). Escopo pedido: Files.ReadWrite.AppFolder.
SLOT2SYNC_ONEDRIVE_CLIENT_ID=
# SLOT2SYNC_ONEDRIVE_TOKEN_PROXY_URL=  # só necessário para o fluxo mobile
